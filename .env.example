INKBOARD_DEVICE_API_TOKEN=replace-with-at-least-32-random-characters
INKBOARD_HOME_ASSISTANT_URL=http://homeassistant.local:8123
INKBOARD_HOME_ASSISTANT_TOKEN=replace-with-a-home-assistant-long-lived-access-token
# Optional starting selection; choose calendars in the admin page instead.
# INKBOARD_HOME_ASSISTANT_CALENDAR=calendar.family,calendar.work
INKBOARD_TIME_ZONE=America/Chicago
INKBOARD_CALENDAR_LOOK_AHEAD_DAYS=7
INKBOARD_CALENDAR_REFRESH_SECONDS=300
# Optional Microsoft To Do app registration; it can also be entered in the admin page.
# INKBOARD_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# INKBOARD_MICROSOFT_TENANT=common
# INKBOARD_TODO_REFRESH_SECONDS=300
# Optional 32-byte key (hex or base64) that encrypts saved sign-ins; generated when unset.
# INKBOARD_SECRET_KEY=
